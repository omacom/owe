[Unit]
Description=owe wallpaper engine daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# A missing Omarchy helper leaves ordinary daemon startup unchanged.
ExecStart=/bin/bash -c 'exec %h/.local/bin/owed --prepare-intro "$("$$OMARCHY_PATH/bin/omarchy-theme-bg-boot-intro" --resolve-startup 2>/dev/null)"'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
