# Maintainer: owe contributors
pkgname=owe-wallpaper-engine
pkgver=0.1.0
pkgrel=1
pkgdesc="High-performance wallpaper engine for Omarchy (mp4, gif, stills)"
arch=('x86_64')
url="https://github.com/example/owe"
license=('MIT')
depends=('mpv' 'ffmpeg' 'wayland' 'libepoxy' 'systemd-libs' 'socat')
makedepends=('meson' 'ninja' 'gcc' 'pkgconf' 'wayland-protocols')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  meson setup build "${srcdir}/${pkgname}-${pkgver}"
  ninja -C build
}

check() {
  meson test -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}/systemd/owed.service" \
    "${pkgdir}/usr/lib/systemd/user/owed.service"
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}/config/config.toml" \
    "${pkgdir}/usr/share/doc/${pkgname}/config.toml.example"
}
